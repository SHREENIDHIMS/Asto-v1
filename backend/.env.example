# Backend environment configuration
# Copy to .env and adjust values for your environment
# Asto settings are prefixed with ASTO_ (see app/config.py)

ASTO_APP_NAME=Asto
ASTO_ENVIRONMENT=development
ASTO_API_PREFIX=/api/v1

# Database — connects to the shared Postgres instance
# The database `asto_assistant` and role `asto_app` are created by
# infra/shared/postgres/init/01_asto_assistant.sql on first container start.
# Set the password via scripts/migrate_db.sh (do NOT commit it).
ASTO_DATABASE_URL=postgresql://asto_app:devpass@127.0.0.1:5433/asto_assistant
ASTO_DATABASE_POOL_MAX=4
ASTO_DATABASE_POOL_TIMEOUT_S=30

# Auth — generate a strong key for production (see docs/)
ASTO_JWT_SECRET=dev-only-secret-change-me-in-production-32chars
ASTO_JWT_ALGORITHM=HS256
ASTO_JWT_EXPIRY_MINUTES=480

# CORS — comma-separated origins; "*" only in non-production
ASTO_CORS_ORIGINS=*

# Embeddings (FastEmbed bge-small-en-v1.5, ~66MB)
ASTO_EMBEDDING_ENABLED=true
ASTO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ASTO_EMBEDDING_CACHE_DIR=nlp_models/embeddings
ASTO_EMBEDDING_DIM=384

# Storage paths (relative to backend/)
ASTO_STORAGE_PENDING_DIR=storage/pending
ASTO_STORAGE_PROCESSED_DIR=storage/processed
ASTO_MAX_UPLOAD_BYTES=20971520

# Search limits
ASTO_BM25_LIMIT=25
ASTO_VECTOR_LIMIT=25
ASTO_MAX_SUB_QUERIES=4

# Response limits
ASTO_MAX_EXCERPT_CHARS=600
ASTO_MAX_EVIDENCE_DOCS=5

# Behavioural
ASTO_AUTO_CREATE_SCHEMA=true
ASTO_AUDIT_ENABLED=true

# Reranker (OFF by default on the micro tier — requires ONNX cross-encoder)
ASTO_RERANK_ENABLED=false
ASTO_RERANK_MODEL_DIR=nlp_models/reranker
