# Asto — local Docker testing environment (repo root)
#
# Copy to .env in the repo root and adjust as needed. Values are consumed
# by docker-compose.yml (${VAR:-default} syntax). None of these are real
# production secrets — this is the LOCAL validation environment only.

# --- Database (docker-to-docker networking: host = service name) ---
ASTO_DATABASE_URL=postgresql://asto_app:devpass@postgres:5432/asto_assistant
# Host port that Postgres is published on (for host-side psycopg access in tests)
POSTGRES_PORT=5433

# --- Backend ---
ASTO_ENVIRONMENT=development
ASTO_JWT_SECRET=dev-only-secret-change-me-in-production-32chars
ASTO_API_PORT=8011

# --- Response / Sumy (top-5 excerpts -> extractive summary) ---
ASTO_MAX_EVIDENCE_DOCS=5

# --- Reranker: MUST stay OFF for the local baseline ---
ASTO_RERANK_ENABLED=false

# --- CORS (dev) ---
ASTO_CORS_ORIGINS=*
